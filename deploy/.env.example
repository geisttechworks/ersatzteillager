# Öffentliche HTTPS-Origin des Reverse Proxys (keinen Pfad anhängen)
APP_ORIGIN=https://lager.firma.example

# PocketBase hört hinter dem Reverse Proxy nur lokal
PB_HOST=127.0.0.1
PB_PORT=8090

# Relative Pfade beziehen sich auf den entpackten Paketordner
PB_DATA_DIR=./data/pb_data
PB_BACKUP_TARGET=./data/backups
PB_BACKUP_RETENTION_DAYS=30

# Optional: genau 32 zufällige Zeichen; niemals in Git übernehmen
PB_ENCRYPTION_KEY=

# Reverse-Proxy-Konfiguration
APP_HOST=lager.firma.example
TLS_CERT_FILE=
TLS_KEY_FILE=
POCKETBASE_UPSTREAM=127.0.0.1:8090
